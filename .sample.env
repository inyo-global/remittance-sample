API_KEY=123456
AGENT_ID=78901
AGENT_KEY=23456
TENANT=sample
# Test environment ("Sandbox" in the docs, host written as https://{FQDN}); Inyo provides the FQDN at onboarding
EXTERNAL_API_URL=https://{FQDN}
VITE_PUBLIC_KEY=123456

# mTLS Cloudflare — paste the complete contents of the files between double quotes
MTLS_CERT="-----BEGIN CERTIFICATE-----
<paste the contents of remittance_sample.pem here>
-----END CERTIFICATE-----"

MTLS_KEY="-----BEGIN PRIVATE KEY-----
<paste the contents of the remittance sample.key here>
-----END PRIVATE KEY-----"

# Public origin of this app, used as the KYC widget redirectUrl. It must not be localhost/127.0.0.1
# (the API rejects loopback hosts). For local development http://lvh.me:3000 resolves to 127.0.0.1;
# open the app from this origin.
APP_URL=http://lvh.me:3000

# Optional Basic Auth for the gateway notification endpoint (POST /api/webhooks/gateway); empty = no auth (local tests only)
WEBHOOK_BASIC_USER=
WEBHOOK_BASIC_PASS=
